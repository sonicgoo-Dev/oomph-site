{
    "key": "group_oomph_tour",
    "title": "Tour",
    "fields": [
        {
            "key": "field_oomph_tour_note",
            "label": "Where the rest lives",
            "name": "",
            "type": "message",
            "message": "The hero photograph is the <strong>Featured image</strong>; it also fronts the tour card. <strong>Destinations</strong> are the checkboxes in the right-hand panel. Publish / Draft is the tour's status. There is no departures table and no availability flag: dates move, and the page says I check them live (D35). Every card reads “Dates and availability confirmed on request.” (D34).",
            "new_lines": "",
            "esc_html": 0
        },
        {
            "key": "field_oomph_tour_operator",
            "label": "Operator",
            "name": "operator",
            "type": "post_object",
            "required": 1,
            "post_type": [ "oomph_operator" ],
            "post_status": [ "publish", "draft" ],
            "taxonomy": "",
            "return_format": "id",
            "multiple": 0,
            "allow_null": 0,
            "bidirectional": 0,
            "ui": 1
        },
        {
